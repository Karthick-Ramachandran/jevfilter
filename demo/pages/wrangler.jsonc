{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project for the demo site (ADR-0009). Static files come from ../public;
  // /api/* is forwarded to the `jevfilter` Worker (../wrangler.jsonc) through a service binding.
  "name": "jevfilter",
  "pages_build_output_dir": "../public",
  "compatibility_date": "2026-09-23",
  "services": [{ "binding": "API", "service": "jevfilter" }]
}
